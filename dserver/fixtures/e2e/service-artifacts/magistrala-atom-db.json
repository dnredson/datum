{
  "schema_version": "0.1.0",
  "artifact_id": "magistrala-atom-db",
  "service_id": "magistrala-atom-db",
  "runtime": {
    "kind": "container",
    "container": {
      "container_name": "datum-magistrala-atom-db",
      "image": "postgres:16-alpine",
      "ports": [
        {
          "container_port": 5432,
          "host_port": 6010,
          "protocol": "tcp"
        }
      ],
      "network": "datum-magistrala-net",
      "volumes": [
        {
          "name": "datum-magistrala-atom-db-volume",
          "target": "/var/lib/postgresql/data",
          "read_only": false
        }
      ]
    }
  },
  "probes": {
    "execution": {
      "kind": "docker_container_running",
      "params": {
        "container_name": "datum-magistrala-atom-db"
      },
      "vantage_point": "local_host"
    },
    "health": {
      "kind": "tcp_connect",
      "params": {
        "target": "127.0.0.1",
        "port": 6010
      },
      "vantage_point": "local_host"
    },
    "availability": {
      "kind": "tcp_connect",
      "params": {
        "target": "127.0.0.1",
        "port": 6010
      },
      "vantage_point": "local_host"
    }
  },
  "metadata": {
    "role": "identity_database",
    "official_compose_service": "atom-db",
    "configuration": {
      "environment_refs": [
        "ATOM_DB_USER",
        "ATOM_DB_PASSWORD",
        "ATOM_DB_NAME"
      ],
      "persistent_volume": "datum-magistrala-atom-db-volume"
    },
    "deployment": {
      "mode": "governed_declarative",
      "phase": "cloud-foundation"
    },
    "compatibility": {
      "magistrala_release": "v1.0.0",
      "atom_release": "v1.0.0",
      "fluxmq_release": "v1.0.0"
    }
  },
  "control_plane": {
    "project_id": "monitor-f49c8",
    "name": "Magistrala v1 Atom PostgreSQL",
    "version": "v1.0.0",
    "artifact_kind": "container",
    "target_nodes": [
      "cloud-01"
    ],
    "target_stages": [
      "cloud"
    ],
    "dependencies": [],
    "acquisition": {
      "kind": "image",
      "source": null,
      "revision": "postgres:16-alpine",
      "sha256": null
    },
    "lifecycle": {
      "pre_install": [],
      "install": [],
      "configure": [],
      "start": [
        {
          "program": "start_container",
          "args": [
            "datum-magistrala-atom-db"
          ],
          "working_dir": null,
          "environment": {}
        }
      ],
      "stop": [],
      "post_install": [],
      "rollback": []
    },
    "health_checks": [],
    "wasm_decision": {
      "explicit_invocation_required": true,
      "module_id": "reconcile_service",
      "function_name": "decide",
      "host_imports_allowed": false,
      "side_effects_allowed": false,
      "safe_to_auto_execute": false,
      "max_fuel": 1000000,
      "timeout_ms": 1000
    },
    "bindings": {
      "POSTGRES_DB": "atom",
      "POSTGRES_USER": "atom"
    },
    "secret_refs": [
      "magistrala_atom_db_password"
    ],
    "created_at_utc": "",
    "updated_at_utc": ""
  }
}
