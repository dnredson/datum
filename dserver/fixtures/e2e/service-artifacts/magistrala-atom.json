{
  "schema_version": "0.1.0",
  "artifact_id": "magistrala-atom",
  "service_id": "magistrala-atom",
  "runtime": {
    "kind": "container",
    "container": {
      "container_name": "datum-magistrala-atom",
      "image": "ghcr.io/absmach/atom:v1.0.0",
      "ports": [
        {
          "container_port": 8080,
          "host_port": 8080,
          "protocol": "tcp"
        }
      ],
      "network": "datum-magistrala-net",
      "volumes": [],
      "configuration_mounts": [
        {
          "source": "magistrala/atom-bootstrap.yaml",
          "target": "/etc/atom/bootstrap.yaml",
          "read_only": true
        }
      ]
    }
  },
  "probes": {
    "execution": {
      "kind": "docker_container_running",
      "params": {
        "container_name": "datum-magistrala-atom"
      },
      "vantage_point": "local_host"
    },
    "health": {
      "kind": "http",
      "params": {
        "url": "http://127.0.0.1:8080/health",
        "expected_status": 200
      },
      "vantage_point": "local_host"
    },
    "availability": {
      "kind": "tcp_connect",
      "params": {
        "host": "127.0.0.1",
        "port": 8080
      },
      "vantage_point": "local_host"
    }
  },
  "metadata": {
    "role": "cloud_platform_api",
    "official_compose_service": "atom",
    "configuration": {
      "environment_refs": [
        "DATABASE_URL",
        "JWT_SECRET",
        "ATOM_KEY_ENCRYPTION_KEY",
        "ADMIN_SECRET",
        "ATOM_SERVICE_SECRET",
        "ATOM_BOOTSTRAP_FILE"
      ],
      "bootstrap_config_artifact": "magistrala-v1-atom-bootstrap.yaml",
      "persistent_volume": null,
      "note": "v1.0.0 loads action and policy bootstrap directly at Atom startup; no atom-bootstrap job container is used."
    },
    "deployment": {
      "mode": "governed_declarative",
      "phase": "cloud-core"
    },
    "compatibility": {
      "magistrala_release": "v1.0.0",
      "atom_release": "v1.0.0",
      "fluxmq_release": "v1.0.0"
    }
  },
  "control_plane": {
    "project_id": "monitor-f49c8",
    "name": "Magistrala v1 Atom identity and GraphQL API",
    "version": "v1.0.0",
    "artifact_kind": "container",
    "target_nodes": [
      "cloud-01"
    ],
    "target_stages": [
      "cloud"
    ],
    "dependencies": [
      "magistrala-atom-db"
    ],
    "acquisition": {
      "kind": "image",
      "source": null,
      "revision": "ghcr.io/absmach/atom:v1.0.0",
      "sha256": null
    },
    "lifecycle": {
      "pre_install": [
        {
          "program": "verify_docker",
          "args": [],
          "working_dir": null,
          "environment": {}
        }
      ],
      "install": [
        {
          "program": "pull_image",
          "args": [],
          "working_dir": null,
          "environment": {}
        }
      ],
      "configure": [
        {
          "program": "verify_configuration_mounts",
          "args": [],
          "working_dir": null,
          "environment": {}
        }
      ],
      "start": [
        {
          "program": "start_container",
          "args": [],
          "working_dir": null,
          "environment": {}
        }
      ],
      "stop": [],
      "post_install": [
        {
          "program": "verify_container_running",
          "args": [],
          "working_dir": null,
          "environment": {}
        }
      ],
      "rollback": [
        {
          "program": "remove_container",
          "args": [],
          "working_dir": null,
          "environment": {}
        }
      ]
    },
    "health_checks": [],
    "wasm_decision": {
      "explicit_invocation_required": true,
      "module_id": "reconcile_service",
      "function_name": "decide",
      "host_imports_allowed": false,
      "side_effects_allowed": false,
      "safe_to_auto_execute": false,
      "max_fuel": 1000000,
      "timeout_ms": 1000
    },
    "bindings": {
      "DATABASE_URL": "postgres://atom-db:5432/atom",
      "LISTEN_ADDR": "0.0.0.0:8080",
      "GRPC_ADDR": "0.0.0.0:8081",
      "ATOM_PUBLIC_BASE_URL": "http://192.168.10.108:8080",
      "ATOM_BOOTSTRAP_FILE": "/etc/atom/bootstrap.yaml",
      "ATOM_CERTS_ENABLED": "false",
      "ATOM_RATE_LIMIT_ENABLED": "false"
    },
    "secret_refs": [
      "magistrala_atom_db_password",
      "magistrala_atom_jwt_secret",
      "magistrala_atom_key_encryption_key",
      "magistrala_atom_admin_secret",
      "magistrala_atom_service_secret"
    ],
    "created_at_utc": "",
    "updated_at_utc": ""
  }
