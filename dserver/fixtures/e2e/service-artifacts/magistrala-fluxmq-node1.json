{
  "schema_version": "0.1.0",
  "artifact_id": "magistrala-fluxmq-node1",
  "service_id": "magistrala-fluxmq-node1",
  "runtime": {
    "kind": "container",
    "container": {
      "container_name": "datum-magistrala-fluxmq-node1",
      "image": "ghcr.io/absmach/fluxmq:latest",
      "ports": [
        {
          "container_port": 1883,
          "host_port": 1883,
          "protocol": "tcp"
        },
        {
          "container_port": 8883,
          "host_port": 8883,
          "protocol": "tcp"
        }
      ]
    }
  },
  "probes": {
    "execution": {
      "kind": "docker_container_running",
      "params": {
        "container_name": "datum-magistrala-fluxmq-node1"
      },
      "vantage_point": "local_host"
    },
    "health": {
      "kind": "tcp_connect",
      "params": {
        "target": "127.0.0.1",
        "port": 1883
      },
      "vantage_point": "local_host"
    },
    "availability": {
      "kind": "tcp_connect",
      "params": {
        "target": "127.0.0.1",
        "port": 1883
      },
      "vantage_point": "local_host"
    }
  },
  "metadata": {
    "role": "message_broker",
    "official_compose_service": "fluxmq-node1",
    "configuration": {
      "template": "magistrala/fluxmq-node1.yaml",
      "image_tag_binding": "MG_FLUXMQ_IMAGE_TAG",
      "persistent_volume": "magistrala-fluxmq-node1-volume"
    },
    "deployment": {
      "mode": "governed_declarative",
      "phase": "cloud-messaging"
    }
  },
  "control_plane": {
    "project_id": "",
    "name": "Magistrala FluxMQ broker",
    "version": "latest",
    "artifact_kind": "container",
    "target_nodes": [
      "cloud-01"
    ],
    "target_stages": [
      "cloud"
    ],
    "dependencies": [
      "magistrala-fluxmq-auth"
    ],
    "acquisition": {
      "kind": "image",
      "source": null,
      "revision": "latest",
      "sha256": null
    },
    "lifecycle": {
      "pre_install": [],
      "install": [],
      "configure": [
        {
          "program": "render_template",
          "args": [
            "magistrala/fluxmq-node1.yaml"
          ],
          "working_dir": null,
          "environment": {}
        }
      ],
      "start": [
        {
          "program": "start_container",
          "args": [
            "datum-magistrala-fluxmq-node1"
          ],
          "working_dir": null,
          "environment": {}
        }
      ],
      "stop": [],
