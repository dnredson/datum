{
  "schema_version": "0.1.0",
  "artifact_id": "chirpstack",
  "service_id": "chirpstack",
  "runtime": {
    "kind": "container",
    "container": {
      "container_name": "datum-chirpstack",
      "image": "chirpstack/chirpstack:4",
      "ports": [
        {
          "host_port": 18081,
          "container_port": 8080,
          "protocol": "tcp"
        },
        {
          "host_port": 19101,
          "container_port": 9100,
          "protocol": "tcp"
        }
      ],
      "network": "datum-fog-net",
      "command": [
        "-c",
        "/etc/chirpstack"
      ],
      "configuration_mounts": [
        {
          "source": "chirpstack/server",
          "target": "/etc/chirpstack",
          "read_only": true
        }
      ]
    }
  },
  "probes": {
    "execution": {
      "kind": "docker_container_running",
      "params": {
        "container_name": "datum-chirpstack"
      },
      "vantage_point": "local_host"
    },
    "health": {
      "kind": "http",
      "params": {
        "url": "http://127.0.0.1:18081/"
      },
      "vantage_point": "local_host"
    },
    "availability": {
      "kind": "tcp_connect",
      "params": {
        "host": "127.0.0.1",
        "port": 18081
      },
      "vantage_point": "local_host"
    }
  },
  "metadata": {
    "role": "lorawan_network_server",
    "official_compose_service": "chirpstack",
    "configuration": {
      "template": "chirpstack/chirpstack.toml",
      "region": "EU868",
      "mqtt_topic_namespace": "eu868"
    },
    "deployment": {
      "mode": "governed_declarative",
      "phase": "fog-lorawan"
    }
  },
  "control_plane": {
    "project_id": "",
    "name": "ChirpStack network server",
    "version": "4",
    "artifact_kind": "container",
    "target_nodes": [
      "fog-01"
    ],
    "target_stages": [
      "fog"
    ],
    "dependencies": [
      "mosquitto",
      "chirpstack-postgres",
      "chirpstack-redis"
    ],
    "acquisition": {
      "kind": "image",
      "source": null,
      "revision": "4",
      "sha256": null
    },
    "lifecycle": {
      "pre_install": [
        {
          "program": "verify_docker",
          "args": [],
          "working_dir": null,
          "environment": {}
        }
      ],
      "install": [
        {
          "program": "pull_image",
          "args": [],
          "working_dir": null,
          "environment": {}
        }
      ],
      "configure": [
        {
          "program": "verify_configuration_mounts",
          "args": [],
          "working_dir": null,
          "environment": {}
        }
      ],
      "start": [
        {
          "program": "start_container",
          "args": [],
          "working_dir": null,
          "environment": {}
        }
      ],
      "stop": [],
      "post_install": [
        {
          "program": "verify_container_running",
          "args": [],
          "working_dir": null,
          "environment": {}
        }
      ],
      "rollback": [
        {
          "program": "remove_container",
          "args": [],
          "working_dir": null,
          "environment": {}
        }
      ]
    },
    "health_checks": [],
    "wasm_decision": {
      "explicit_invocation_required": true,
      "module_id": "reconcile_service",
      "function_name": "decide",
      "host_imports_allowed": false,
      "side_effects_allowed": false,
      "safe_to_auto_execute": false,
      "max_fuel": 1000000,
      "timeout_ms": 1000
    },
    "bindings": {
      "POSTGRESQL_HOST": "chirpstack-postgres",
      "REDIS_HOST": "chirpstack-redis",
      "MQTT_BROKER_HOST": "mqtt"
    },
    "secret_refs": [
      "chirpstack_postgres_password",
      "chirpstack_api_secret"
    ],
    "created_at_utc": "",
    "updated_at_utc": ""
  }
}
