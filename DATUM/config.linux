[agent]
node_id = "fog-01"
cycle_s = 5
schema_version = "0.0.1"

[outputs.file_json]
enabled = true
path = "snapshot.json"

# futuro (stub)
[outputs.http]
enabled = false
url = "http://localhost:8080/v1/snapshots"

[dispatch]
enabled = true
allow_container_execution = true

[[dispatch.container_mappings]]
service_name = "mqtt"
container_name = "datum-fog-mosquitto"
artifact = "eclipse-mosquitto:2"

#[collectors.process_windows]
#enabled = true
#mode = "group_by_name"                                                   # novo (default recomendado)
#names = ["docker desktop.exe", "dockerd.exe", "datum.exe", "chrome.exe"]
#max_entries = 50
#include_pids = false                                                     # opcional

[collectors.process_linux]
enabled = true
#mode = "all"
mode = "allowlist"
names = ["sshd", "datum"]
max_entries = 50

[collectors.connection_ping]
enabled = true
targets = ["1.1.1.1", "8.8.8.8"]
count = 4
timeout_s = 1

# Optional TCP peer probes. Each node skips its own identity.
# The laboratory uses SSH port 22 as a lightweight reachability target;
# replace it with an agent-owned probe port when that listener is deployed.
[[collectors.connection_ping.peer_targets]]
node_id = "fog-01"
target = "192.168.10.103"
port = 22
timeout_s = 2

[[collectors.connection_ping.peer_targets]]
node_id = "cloud-01"
target = "192.168.10.108"
port = 22
timeout_s = 2

[collectors.docker]
enabled = true
mode = "allowlist"
names = ["datum-fog-mosquitto"]
max_entries = 20

[services]
enabled = true

[[services.items]]
name = "mosquitto"
implemented_by = [{ container_name = "mosquitto" }]

[[services.items]]
name = "mqtt"
implemented_by = [{ container_name = "datum-fog-mosquitto" }]

[[services.items]]
name = "datum-agent"
implemented_by = [{ process_name = "datum" }]
