[agent]
node_id = "fog-01"
cycle_s = 5
schema_version = "0.0.1"

[outputs.file_json]
enabled = true
path = "snapshot.json"

# futuro (stub)
[outputs.http]
enabled = false
url = "http://localhost:8080/v1/snapshots"

[dispatch]
enabled = true
allow_container_execution = true
configuration_root = "/opt/datum/governed-config"

[[dispatch.secret_bindings]]
secret_ref = "chirpstack_postgres_password"
environment_variable = "POSTGRES_PASSWORD"

[[dispatch.secret_bindings]]
secret_ref = "chirpstack_api_secret"
environment_variable = "CHIRPSTACK_API_SECRET"

[[dispatch.container_mappings]]
service_name = "mqtt"
container_name = "datum-mosquitto"
artifact = "docker.io/library/eclipse-mosquitto@sha256:6dba0f1b2795ddcbe0d41bdfb8b8d56a423acca23ccde4342a4652be54639b11"
ports = [{ host_port = 1883, container_port = 1883, protocol = "tcp" }]

#[collectors.process_windows]
#enabled = true
#mode = "group_by_name"
#names = ["docker desktop.exe", "dockerd.exe", "datum.exe", "chrome.exe"]
#max_entries = 50
#include_pids = false

[collectors.process_linux]
enabled = true
mode = "allowlist"
names = ["sshd", "datum"]
max_entries = 50

[collectors.connection_ping]
enabled = true
targets = ["1.1.1.1", "8.8.8.8"]
count = 4
timeout_s = 1

# Optional TCP peer probes.
[[collectors.connection_ping.peer_targets]]
node_id = "fog-01"
target = "192.168.10.103"
port = 22
timeout_s = 2

[[collectors.connection_ping.peer_targets]]
node_id = "cloud-01"
target = "192.168.10.108"
port = 22
timeout_s = 2

[collectors.docker]
enabled = true
mode = "allowlist"
names = ["datum-mosquitto", "datum-chirpstack-postgres", "datum-chirpstack-redis", "datum-chirpstack", "datum-chirpstack-provisioner"]
max_entries = 20

[services]
enabled = true

[[services.items]]
name = "mqtt"
implemented_by = [{ container_name = "datum-mosquitto" }]

[[services.items]]
name = "datum-agent"
implemented_by = [{ process_name = "datum" }]

[[dispatch.container_mappings]]
service_name = "chirpstack-postgres"
container_name = "datum-chirpstack-postgres"
artifact = "docker.io/library/postgres@sha256:3b36dd7df1337107cef7502b1e3e94c971483ae87498a9310d25c60fba08cfc9"
ports = []

[[dispatch.container_mappings]]
service_name = "chirpstack-redis"
container_name = "datum-chirpstack-redis"
artifact = "docker.io/library/redis@sha256:1db42ccef14898aa29bae778452d567534b59c107129cbc1163fb552de184d3c"
ports = []

[[dispatch.container_mappings]]
service_name = "chirpstack"
container_name = "datum-chirpstack"
artifact = "docker.io/chirpstack/chirpstack@sha256:c749015e640b8cf33338c08b12922896b17636feb06e421abdd3cc80f1cdc6b9"
command = ["-c", "/etc/chirpstack"]
ports = [{ host_port = 18081, container_port = 8080, protocol = "tcp" }, { host_port = 19101, container_port = 9100, protocol = "tcp" }]

[[services.items]]
name = "chirpstack-postgres"
implemented_by = [{ container_name = "datum-chirpstack-postgres" }]

[[services.items]]
name = "chirpstack-redis"
implemented_by = [{ container_name = "datum-chirpstack-redis" }]

[[services.items]]
name = "chirpstack"
implemented_by = [{ container_name = "datum-chirpstack" }]

[[dispatch.container_mappings]]
service_name = "chirpstack-provisioner"
container_name = "datum-chirpstack-provisioner"
artifact = "ghcr.io/dnredson/chirpstack-provisioner@sha256:6e12ba9787be723bb2b404cfab6a7cfc79300ab237fc61dd0a839a93b675de29"
ports = [{ host_port = 18082, container_port = 8085, protocol = "tcp" }]

[[services.items]]
name = "chirpstack-provisioner"
implemented_by = [{ container_name = "datum-chirpstack-provisioner" }]
